    descTH: "\u0E15\u0E49\u0E21\u0E44\u0E02\u0E48\u0E21\u0E38\u0E01 + \u0E2A\u0E31\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E2D\u0E31\u0E15\u0E42\u0E19\u0E21\u0E31\u0E15\u0E34
