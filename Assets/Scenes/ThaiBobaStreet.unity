  m_Script: {fileID: 11500000, guid: a8886371072dcd747895f9fded8b5610, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UpgradeShop
  upgrades:
  - id: speaker
    nameTH: "\u0E25\u0E33\u0E42\u0E1E\u0E07\u0E40\u0E1B\u0E34\u0E14\u0E40\u0E1E\u0E25\u0E07\u0E25\u0E39\u0E01\u0E17\u0E38\u0E48\u0E07"
    descriptionTH: "\u0E1A\u0E23\u0E23\u0E22\u0E32\u0E01\u0E32\u0E28\u0E14\u0E35
      \u0E17\u0E34\u0E1B +10%"
    nameEN: Luk thung speaker
    descriptionEN: 'Good vibes: tips +10%'
    price: 250
    owned: 0
    enableWhenOwned:
    - {fileID: 699309406}
    - {fileID: 483996685}
  - id: fan
    nameTH: "\u0E1E\u0E31\u0E14\u0E25\u0E21\u0E15\u0E31\u0E49\u0E07\u0E1E\u0E37\u0E49\u0E19"
    descriptionTH: "\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32\u0E43\u0E08\u0E40\u0E22\u0E47\u0E19\u0E02\u0E36\u0E49\u0E19
      \u0E04\u0E27\u0E32\u0E21\u0E2D\u0E14\u0E17\u0E19 +20%"
    nameEN: Standing fan
    descriptionEN: 'Cooler customers: patience +20%'
    price: 300
    owned: 0
    enableWhenOwned:
    - {fileID: 83541794}
  - id: seating
    nameTH: "\u0E42\u0E15\u0E4A\u0E30\u0E2A\u0E41\u0E15\u0E19\u0E40\u0E25\u0E2A +
      \u0E40\u0E01\u0E49\u0E32\u0E2D\u0E35\u0E49\u0E41\u0E14\u0E07"
    descriptionTH: "\u0E19\u0E31\u0E48\u0E07\u0E23\u0E2D\u0E2A\u0E1A\u0E32\u0E22
      \u0E04\u0E27\u0E32\u0E21\u0E2D\u0E14\u0E17\u0E19 +10% \u0E17\u0E34\u0E1B +10%"
    nameEN: Steel table + red stools
    descriptionEN: 'Comfy waiting: patience +10%, tips +10%'
    price: 450
    owned: 0
    enableWhenOwned:
    - {fileID: 1166729578}
    - {fileID: 993740695}
    - {fileID: 247730518}
    - {fileID: 1075716922}
    - {fileID: 473714294}
  - id: bigger_pot
    nameTH: "\u0E2B\u0E21\u0E49\u0E2D\u0E15\u0E49\u0E21\u0E44\u0E02\u0E48\u0E21\u0E38\u0E01\u0E43\u0E1A\u0E43\u0E2B\u0E0D\u0E48"
    descriptionTH: "\u0E15\u0E49\u0E21\u0E44\u0E14\u0E49\u0E04\u0E23\u0E31\u0E49\u0E07\u0E25\u0E30
      50 \u0E17\u0E35\u0E48 + \u0E44\u0E02\u0E48\u0E21\u0E38\u0E01\u0E14\u0E34\u0E1A\u0E1F\u0E23\u0E35
      60 \u0E17\u0E38\u0E01\u0E40\u0E0A\u0E49\u0E32"
    nameEN: Big pearl pot
    descriptionEN: Cooks 50 portions per batch + 60 free raw pearls every morning
    price: 500
    owned: 0
    enableWhenOwned: []
  - id: fast_sealer
    nameTH: "\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E0B\u0E35\u0E25\u0E23\u0E38\u0E48\u0E19\u0E40\u0E17\u0E2D\u0E23\u0E4C\u0E42\u0E1A"
    descriptionTH: "\u0E0B\u0E35\u0E25\u0E41\u0E01\u0E49\u0E27\u0E40\u0E23\u0E47\u0E27\u0E02\u0E36\u0E49\u0E19
      3 \u0E40\u0E17\u0E48\u0E32"
    nameEN: Turbo sealer
    descriptionEN: Seals cups 3x faster
    price: 600
    owned: 0
    enableWhenOwned:
    - {fileID: 1377967441}
  - id: neon
    nameTH: "\u0E1B\u0E49\u0E32\u0E22\u0E44\u0E1F\u0E19\u0E35\u0E2D\u0E2D\u0E19"
    descriptionTH: "\u0E23\u0E49\u0E32\u0E19\u0E40\u0E14\u0E48\u0E19 \u0E25\u0E39\u0E01\u0E04\u0E49\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E21
      25%"
    nameEN: Neon sign
    descriptionEN: 'Stand out: +25% customers'
    price: 800
    owned: 0
    enableWhenOwned:
    - {fileID: 1989551360}
    - {fileID: 219589038}
  - id: delivery
    nameTH: "\u0E40\u0E1B\u0E34\u0E14\u0E23\u0E31\u0E1A\u0E40\u0E14\u0E25\u0E34\u0E40\u0E27\u0E2D\u0E23\u0E35\u0E48"
    descriptionTH: "\u0E23\u0E32\u0E22\u0E44\u0E14\u0E49\u0E40\u0E1E\u0E34\u0E48\u0E21
      15% \u0E02\u0E2D\u0E07\u0E22\u0E2D\u0E14\u0E02\u0E32\u0E22\u0E17\u0E38\u0E01\u0E27\u0E31\u0E19"
    nameEN: Delivery service
