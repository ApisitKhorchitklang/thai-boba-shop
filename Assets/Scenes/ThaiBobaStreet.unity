    descTH: "\u0E23\u0E49\u0E32\u0E19\u0E21\u0E35\u0E2A\u0E44\u0E15\u0E25\u0E4C"
    descEN: A shop with style
    price: 600
    beauty: 2
    kind: 0
    show: {fileID: 1162785407}
    hide: {fileID: 0}
  - id: bench
    nameTH: "\u0E21\u0E49\u0E32\u0E19\u0E31\u0E48\u0E07\u0E23\u0E2D\u0E2B\u0E19\u0E49\u0E32\u0E23\u0E49\u0E32\u0E19"
    nameEN: Waiting bench
    descTH: "\u0E25\u0E39\u0E01\u0E04\u0E49\u0E32\u0E43\u0E08\u0E40\u0E22\u0E47\u0E19\u0E02\u0E36\u0E49\u0E19"
    descEN: Customers wait longer
    price: 450
    beauty: 1
    kind: 0
    show: {fileID: 1276416299}
    hide: {fileID: 0}
  - id: helper
    nameTH: "\u0E08\u0E49\u0E32\u0E07\u0E1E\u0E19\u0E31\u0E01\u0E07\u0E32\u0E19"
    nameEN: Hire a helper
    descTH: "\u0E15\u0E49\u0E21\u0E44\u0E02\u0E48\u0E21\u0E38\u0E01 + \u0E2A\u0E31\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E2D\u0E31\u0E15\u0E42\u0E19\u0E21\u0E31\u0E15\u0E34
      \xB7 \u0E04\u0E48\u0E32\u0E41\u0E23\u0E07 120 \u0E3F/\u0E27\u0E31\u0E19"
