    nameEN: Lucky cat
    descTH: "\u0E17\u0E34\u0E1B\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E19\u0E34\u0E14\u0E2B\u0E19\u0E48\u0E2D\u0E22"
