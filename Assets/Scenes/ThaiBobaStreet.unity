    descTH: "\u0E15\u0E49\u0E21\u0E44\u0E02\u0E48\u0E21\u0E38\u0E01 + \u0E2A\u0E31\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E43\u0E2B\u0E49\u0E2D\u0E31\u0E15\u0E42\u0E19\u0E21\u0E31\u0E15\u0E34
      \xB7 \u0E04\u0E48\u0E32\u0E41\u0E23\u0E07 120 \u0E3F/\u0E27\u0E31\u0E19"
    descEN: "Cooks pearls + reorders stock \xB7 wage 120 \u0E3F/day"
    price: 1500
    beauty: 0
    kind: 1
    show: {fileID: 1555946646}
    hide: {fileID: 0}
  - id: expand
    nameTH: "\u0E02\u0E22\u0E32\u0E22\u0E23\u0E49\u0E32\u0E19\u0E44\u0E1B\u0E15\u0E36\u0E01\u0E02\u0E49\u0E32\u0E07\u0E46"
    nameEN: Expand next door
    descTH: "\u0E21\u0E35\u0E17\u0E35\u0E48\u0E19\u0E31\u0E48\u0E07\u0E40\u0E1E\u0E34\u0E48\u0E21
